# 複製成 .env 再啟動：cp .env.example .env
# 這些是本地學習用的預設值；任何對外的環境都必須換掉

# S3（RustFS）帳密，Spark / Iceberg REST / aws-cli 共用
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
AWS_REGION=us-east-1

# Airflow / dbt 容器用的身分：你的 UID（執行 id -u）與 docker.sock 的群組 ID
# docker.sock 的 GID 查法：docker run --rm -v /var/run/docker.sock:/s alpine stat -c %g /s
HOST_UID=1000
DOCKER_GID=1001
